# 本草通 2.0（tcm-kg）环境变量样例 —— 复制为 backend/.env 后按需修改
# 说明：settings 的 env_file=".env" 相对进程工作目录解析，后端命令均在 backend/ 下
# 运行（uv run / make check / tcm），故 .env 必须放在 backend/.env。
# 变量规范见 backend/src/tcm_kg/core/settings.py（前缀 TCM_ + 嵌套分隔 __）

# ===== LLM（必填，OpenAI 兼容接口）=====
TCM_LLM__BASE_URL=https://api.openai.com/v1
TCM_LLM__API_KEY=sk-your-key-here
TCM_LLM__MODEL=gpt-4o
# TCM_LLM__TEMPERATURE=0.1

# ===== Neo4j（默认对应 docker-compose.yml 本地开发值，按需覆盖）=====
# TCM_NEO4J__URI=bolt://localhost:7687
# TCM_NEO4J__USER=neo4j
# TCM_NEO4J__PASSWORD=tcmkg-dev-password
# TCM_NEO4J__DATABASE=neo4j

# ===== 嵌入模型（bge-m3，ADR-004；支持 HuggingFace 名称或本地缓存路径）=====
# TCM_EMBEDDING__MODEL_NAME=BAAI/bge-m3
# TCM_EMBEDDING__DIM=1024
# TCM_EMBEDDING__DEVICE=cpu
# TCM_EMBEDDING__BATCH_SIZE=32

# ===== API 服务（Phase F）=====
# TCM_API__HOST=127.0.0.1
# TCM_API__PORT=8000

# ===== 数据管线（Phase C）=====
# TCM_PIPELINE__LLM_CONCURRENCY=5
# TCM_PIPELINE__ALIGN_TOPK=10
# TCM_PIPELINE__LOAD_BATCH_SIZE=1000

# ===== Langfuse 可观测（make up-observability 后在 http://localhost:3001 建项目获取密钥）=====
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# ===== docker compose（Neo4j 密码；注意：此项供根目录 .env 使用，docker compose
# 读取项目根 .env，而非 backend/.env；默认 tcmkg-dev-password 仅限本地开发）=====
# NEO4J_PASSWORD=tcmkg-dev-password

# ===== 实验脚本（smilt/ DeepEavl/ 学习用脚本，主代码不依赖）=====
# smilt/Nopipeline.py：LangSmith 追踪 + 通义千问
# LANGCHAIN_API_KEY=lsv2-pt-your-langsmith-key
# OPENAI_API_KEY=sk-your-dashscope-key
# DeepEavl/judge.py：通义千问评估裁判（缺省回退读 OPENAI_API_KEY）
# QWEN_API_KEY=sk-your-dashscope-key
